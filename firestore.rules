rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function authEmailLower() {
      return request.auth.token.email.lower();
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function bootstrapAdmin() {
      return signedIn() && (
        authEmailLower() == 'magnar.totland@gmail.com' ||
        authEmailLower() == 'totland.s@gmail.com'
      );
    }
    function directoryInvite() {
      return signedIn()
        && exists(/databases/$(database)/documents/userDirectory/$(authEmailLower()));
    }
    // Sperret i userDirectory = ingen tilgang via rollen i users/{uid}.
    function notBlocked() {
      let dir = /databases/$(database)/documents/userDirectory/$(authEmailLower());
      return !exists(dir) || get(dir).data.get('status', 'aktiv') != 'sperret';
    }
    function isAdmin() {
      return signedIn() && userDoc().role == 'admin' && notBlocked();
    }
    function canAdminWrite() {
      return bootstrapAdmin() || isAdmin();
    }
    function isCoordinator() {
      return signedIn() && userDoc().role == 'coordinator' && notBlocked();
    }
    function isSponsor() {
      return signedIn() && userDoc().role == 'sponsor' && notBlocked();
    }
    function ownCoordinator() {
      return isCoordinator() && userDoc().coordinatorId == resource.data.koordinatorId;
    }
    // Koordinator som følger barnet (slås opp på barnet, også for poster uten koordinatorId).
    function coordinatorOfChild(barnId) {
      return isCoordinator()
        && get(/databases/$(database)/documents/children/$(barnId)).data.koordinatorId == userDoc().coordinatorId;
    }
    function ownsNew() {
      return isCoordinator() && request.resource.data.koordinatorId == userDoc().coordinatorId;
    }
    function ownSponsorChild() {
      return isSponsor() && resource.data.tildeltFadderId == userDoc().sponsorId;
    }

    match /userDirectory/{emailId} {
      allow read: if signedIn() && (authEmailLower() == emailId || canAdminWrite());
      allow create, delete: if canAdminWrite();
      // Ved første innlogging setter personen selv invitert → aktiv, og ingenting annet.
      allow update: if canAdminWrite()
        || (signedIn() && authEmailLower() == emailId
          && resource.data.get('status', 'aktiv') == 'invitert'
          && request.resource.data.status == 'aktiv'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
    }

    // Rolle og tilknytning i egen profil må stemme med invitasjonen i userDirectory.
    function matchesDirectory(data) {
      let entry = get(/databases/$(database)/documents/userDirectory/$(authEmailLower())).data;
      return data.role == entry.role
        && data.get('coordinatorId', null) == entry.get('coordinatorId', null)
        && data.get('sponsorId', null) == entry.get('sponsorId', null);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || canAdminWrite());
      allow create: if canAdminWrite()
        || (signedIn() && request.auth.uid == uid
          && directoryInvite() && matchesDirectory(request.resource.data));
      // Egen profil: fritt for ufarlige felt; rolle/tilknytning bare til det userDirectory sier.
      allow update: if canAdminWrite()
        || (signedIn() && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'email'])
          && (!request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'coordinatorId', 'sponsorId'])
            || (directoryInvite() && matchesDirectory(request.resource.data))));
      allow delete: if isAdmin();
    }

    match /coordinators/{id} {
      allow read: if canAdminWrite() || (isCoordinator() && userDoc().coordinatorId == id);
      allow write: if canAdminWrite();
    }

    match /sponsors/{id} {
      allow read: if canAdminWrite() || (isSponsor() && userDoc().sponsorId == id);
      allow create: if canAdminWrite() || (
        request.resource.data.registrertKilde == 'nettside'
        && request.resource.data.navn is string
        && request.resource.data.navn.size() >= 2
        && request.resource.data.navn.size() <= 80
        && request.resource.data.epost is string
        && request.resource.data.epost.matches('.+@.+\\..+')
        && request.resource.data.maanedsbelop is number
        && request.resource.data.maanedsbelop >= 100
        && request.resource.data.maanedsbelop <= 20000
        && request.resource.data.tildeltBarnIds is list
        && request.resource.data.tildeltBarnIds.size() == 0
        && request.resource.data.betalingsmetode in ['vipps', 'avtalegiro', 'bank']
        && request.resource.data.betalingsstatus == 'aktiv'
        && (!('vippsAgreementStatus' in request.resource.data)
          || request.resource.data.vippsAgreementStatus == 'PENDING')
      );
      allow update, delete: if canAdminWrite();
    }

    match /sponsorAssignments/{id} {
      allow read: if canAdminWrite()
        || (isSponsor() && resource.data.sponsorId == userDoc().sponsorId);
      allow write: if canAdminWrite();
    }

    match /recurringCharges/{id} {
      allow read: if canAdminWrite()
        || (isSponsor() && resource.data.sponsorId == userDoc().sponsorId);
      allow write: if canAdminWrite();
    }

    match /paymentAllocations/{id} {
      allow read: if canAdminWrite()
        || (isSponsor() && resource.data.sponsorId == userDoc().sponsorId)
        || (isCoordinator() && resource.data.koordinatorId == userDoc().coordinatorId);
      allow write: if canAdminWrite();
    }

    match /children/{id} {
      allow read: if canAdminWrite() || ownCoordinator() || ownSponsorChild();
      // Koordinator: bare egne barn, og kan ikke flytte barnet eller bytte fadder.
      allow create: if canAdminWrite() || (ownsNew() && !('tildeltFadderId' in request.resource.data));
      allow update: if canAdminWrite()
        || (ownCoordinator()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['koordinatorId', 'tildeltFadderId']));
      allow delete: if canAdminWrite();
    }

    match /facts/{id} {
      allow read: if canAdminWrite() || ownCoordinator();
      allow create: if canAdminWrite() || (ownsNew() && coordinatorOfChild(request.resource.data.barnId));
      allow update: if canAdminWrite();
      allow delete: if canAdminWrite();
    }

    match /reports/{id} {
      allow read: if canAdminWrite()
        || ownCoordinator()
        || (isSponsor() && get(/databases/$(database)/documents/children/$(resource.data.barnId)).data.tildeltFadderId == userDoc().sponsorId
            && resource.data.status == 'godkjent');
      // Koordinator sender inn for egne barn; godkjent status settes bare av admin.
      allow create: if canAdminWrite()
        || (ownsNew() && coordinatorOfChild(request.resource.data.barnId)
          && request.resource.data.status in ['kladd', 'innsendt']);
      allow update: if canAdminWrite();
      allow delete: if canAdminWrite();
    }

    match /milestones/{id} {
      allow read: if canAdminWrite()
        || ownCoordinator()
        || (isSponsor() && get(/databases/$(database)/documents/children/$(resource.data.barnId)).data.tildeltFadderId == userDoc().sponsorId);
      allow create: if canAdminWrite() || coordinatorOfChild(request.resource.data.barnId);
      allow update: if canAdminWrite() || coordinatorOfChild(resource.data.barnId);
      allow delete: if canAdminWrite();
    }

    match /inquiries/{id} {
      allow read: if canAdminWrite()
        || (isSponsor() && resource.data.fadderId == userDoc().sponsorId)
        || ownCoordinator();
      allow create: if canAdminWrite() || (isSponsor() && request.resource.data.fadderId == userDoc().sponsorId);
      allow update: if canAdminWrite() || ownCoordinator();
      allow delete: if canAdminWrite();
    }

    match /payments/{id} {
      allow read: if canAdminWrite() || (isSponsor() && resource.data.fadderId == userDoc().sponsorId);
      allow write: if canAdminWrite();
    }

    match /campaigns/{id} {
      allow read: if true;
      allow write: if canAdminWrite();
    }

    match /testimonials/{id} {
      allow read: if resource.data.godkjentAvAdmin == true || canAdminWrite();
      allow write: if canAdminWrite();
    }

    match /notifications/{id} {
      allow read: if canAdminWrite()
        || (signedIn() && resource.data.recipientId == userDoc().sponsorId)
        || (signedIn() && resource.data.recipientId == userDoc().coordinatorId)
        || (canAdminWrite() && resource.data.targetRole == 'admin');
      allow write: if canAdminWrite() || signedIn();
    }

    match /auditLogs/{id} {
      allow read, write: if canAdminWrite();
    }

    match /cms/{id} {
      allow read: if true;
      allow write: if canAdminWrite();
    }

    match /newsletterLogs/{id} {
      allow read, write: if canAdminWrite();
    }

    match /emailOutbox/{id} {
      allow read, write: if canAdminWrite();
    }

    match /catalogPhotos/{id} {
      allow read: if canAdminWrite() || ownCoordinator();
      allow create: if canAdminWrite() || ownsNew();
      allow update: if canAdminWrite() || ownCoordinator();
      allow delete: if canAdminWrite();
    }

    match /mediaLibrary/{id} {
      allow read, write: if canAdminWrite();
    }

    match /settings/{id} {
      allow read, write: if canAdminWrite();
    }

    match /system/{id} {
      allow read: if canAdminWrite();
      allow create: if canAdminWrite() && (id == 'seedLock' || id == 'vippsChargeJob');
      allow update: if canAdminWrite() && id == 'vippsChargeJob';
      allow delete: if false;
    }
  }
}
